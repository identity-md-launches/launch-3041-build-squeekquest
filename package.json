{
  "name": "squeekquest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A hamster adventure connected to verifiable SqueekChain Sepolia data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/export.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:api": "node --import tsx scripts/check-api.ts",
    "test:browser": "node scripts/check-browser.mjs",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "check:export": "node scripts/check-export.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "playwright": "^1.58.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
